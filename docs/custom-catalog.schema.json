{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sampsih/target-mac-dfu/blob/main/docs/custom-catalog.schema.json",
  "title": "Target Mac DFU custom firmware catalog",
  "type": "object",
  "required": ["devices"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identifier", "firmwares"],
        "properties": {
          "name": {
            "type": "string"
          },
          "identifier": {
            "type": "string",
            "pattern": "^(Mac|MacBookPro|MacBookAir|Macmini|iMac|iMacPro|MacPro)[0-9]+,[0-9]+$"
          },
          "firmwares": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "build", "url", "signed"],
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "build": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "filename": {
                  "type": "string",
                  "pattern": "\\.ipsw$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "sha1": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{40}$"
                },
                "signed": {
                  "type": "boolean"
                },
                "beta": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
